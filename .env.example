# Vrindha Environment Variables per Deployment Prompt
# Use environment variables, secure API endpoints

# Security
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database - SQLite initial, PostgreSQL later per blueprint
DATABASE_URL=sqlite:///./database/vrindha.db
# DATABASE_URL=postgresql://user:password@localhost/vrindha

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True

# Mode
VRINDHA_MODE=defensive
# VRINDHA_MODE=offensive  # requires explicit authorization token

# Dharma Engine
DHARMA_ENABLED=True
GITA_JSON_PATH=data/gita.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/log.txt

# Deployment
# For AWS/VPS with Nginx HTTPS per blueprint:
# NGINX_ENABLED=True
# HTTPS_ENABLED=True
# DOMAIN=your-domain.com

# Tools Config
# NMAP_DEFAULT_TARGET=127.0.0.1
# FAIL2BAN_THRESHOLD=5
