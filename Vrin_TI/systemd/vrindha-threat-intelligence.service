[Unit]
Description=Vrindha Threat Intelligence Service
Documentation=file://@TI_ROOT@/docs/threat-intelligence-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@REPOSITORY_ROOT@
EnvironmentFile=/etc/vrindha/vrindha-ti.env
Environment=PYTHONPATH=@REPOSITORY_ROOT@
ExecStart=@TI_PYTHON@ -m uvicorn Vrin_TI.api:app --host 127.0.0.1 --port 8010 --no-server-header
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=@TI_ROOT@/database @TI_ROOT@/logs @TI_ROOT@/quarantine

[Install]
WantedBy=multi-user.target
