# Copy to .env and replace every example value before starting the API.
SECRET_KEY=replace-with-at-least-32-random-characters
ALGORITHM=HS256
# Bearer-token lifetime in minutes. Keep it short (e.g. 480 = 8 hours); a
# stolen long-lived token stays valid until it expires or the account is
# disabled.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# An administrator is provisioned only when both values are supplied.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters

DATABASE_URL=sqlite:///./database/vrindha.db
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=False

# Comma-separated browser origins. Leave empty for same-origin dashboard only.
CORS_ORIGINS=
# Public active scanning is denied by default. Enable only in a controlled,
# explicitly authorized deployment.
ALLOW_PUBLIC_TARGETS=False

VRINDHA_MODE=defensive
DHARMA_ENABLED=True
GITA_JSON_PATH=data/gita.json
LOG_LEVEL=INFO
LOG_FILE=logs/log.txt
DEBUG=False

# Independent Vrin_TI service and authenticated SOC↔TI gateway.
VRINDHA_TI_ENABLED=true
VRINDHA_TI_HOST=127.0.0.1
VRINDHA_TI_PORT=8010
VRINDHA_TI_URL=http://127.0.0.1:8010
VRINDHA_SOC_URL=http://127.0.0.1:8000
VRINDHA_INTELLIGENCE_BUS=auto
# Generate independently: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
VRINDHA_TI_API_KEY=
VRINDHA_REDIS_URL=
VRINDHA_NATS_URL=
VRINDHA_TI_EXTERNAL_ENRICHMENT=false
VRINDHA_TI_EXTERNAL_SUBMISSION=false
VRINDHA_TI_COLLECT_ON_START=false

# Optional feeds/providers/connectors. Empty means disabled.
NVD_API_KEY=
VRINDHA_TAXII_COLLECTION_URL=
VRINDHA_TAXII_TOKEN=
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
MISP_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_TOKEN=
SURICATA_EVE_PATH=
ZEEK_LOG_DIR=
YARA_RULES_PATH=
# Relative TI paths resolve inside the sibling Vrin_TI directory.
SIGMA_RULES_PATH=rules/sigma
